      "position": [
        160,
        140
      ]
    },
    {
      "parameters": {
        "content": "## ⚙️ Search Configuration\nSet your target German city (e.g. Berlin, München), industry keyword (e.g. IT-Beratung, Steuerberater), and your Apify API Token.",
        "height": 260,
        "width": 240,
        "color": 5
      },
      "id": "sticky-2",
