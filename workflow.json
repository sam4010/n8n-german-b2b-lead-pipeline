      "position": [
        1180,
        140
      ]
    },
    {
      "parameters": {
        "content": "## 📊 Final Output\nCombines directory contacts with verified executive names into normalized, CRM-ready lead records.",
        "height": 260,
        "width": 220,
        "color": 2
