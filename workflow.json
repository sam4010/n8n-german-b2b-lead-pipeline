      ]
    },
    {
      "parameters": {
        "content": "## 🇩🇪 Step 1: Directory Scrape\nCalls Apify Gelbe Seiten Scraper to pull verified German businesses, direct phones, and clean website domains.",
        "height": 260,
        "width": 260,
        "color": 6
